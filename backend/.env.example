# backend/.env.example
# Copy to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env
#
# Every component reads THIS file:
#   - backend/server.js            -> require('dotenv').config()          (cwd-relative)
#   - browser-automation-engine/*  -> dotenv.config({ path: '../backend/.env' })
# so you do NOT need a .env inside browser-automation-engine/.
#
# PostgreSQL/HTTP gateway used for all Venus HR queries. Must point at the
# /query endpoint. Defaults to http://localhost:8001 if unset.
GATEWAY_URL=http://localhost:8001/query

# Auth token for the gateway (Venus HR API).
API_TOKEN_QUERY=

# Which server profile to query: SERVER_PROFILE_1, SERVER_PROFILE_2, ...
SERVER_PROFILE=SERVER_PROFILE_1

# Unified API + static frontend port (backend serves frontend/dist in production).
PORT=3002

# Local fallback for extend_db_ptrj when SERVER_PROFILE_1 is unavailable.
# Leave LOCAL_EXTEND_DB_ENABLED=false unless you need the fallback.
LOCAL_EXTEND_DB_ENABLED=false
LOCAL_EXTEND_DB_SERVER=
LOCAL_EXTEND_DB_INSTANCE=
LOCAL_EXTEND_DB_PORT=
LOCAL_EXTEND_DB_DATABASE=
LOCAL_EXTEND_DB_USER=
LOCAL_EXTEND_DB_PASSWORD=
LOCAL_EXTEND_DB_ENCRYPT=true
LOCAL_EXTEND_DB_TRUST_CERT=true
EXTEND_DB_GATEWAY_TIMEOUT=30000

# Set to true to use overtime-only mode (skip T_Machine table).
NO_ATTENDANCE=false

# ═══════════════════════════════════════════════════════════════════
# BROWSER AUTOMATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Number of browser instances for parallel automation (1, 2, 3, etc.)
# Employees are distributed evenly across instances.
AUTOMATION_INSTANCES=2

# Delay between engine starts in milliseconds.
ENGINE_START_DELAY=2000

# Set to true for headless browser (no visible window).
HEADLESS=true

# Auto-close browsers when automation completes.
AUTO_CLOSE=true

# ── Timeouts / crash guards ─────────────────────────────────────────
# Kept deliberate: lower values make a blocked tab fail fast instead of
# hanging the whole run.
PUPPETEER_PROTOCOL_TIMEOUT=60000   # CDP protocol timeout (ms)
MULTI_TAB_TIMEOUT=900000           # Hard deadline per tab (ms)
MULTI_WINDOW_TIMEOUT=2700000       # Global deadline for a multi-window run (ms)
PAYROLL_WORKER_TIMEOUT=1800000     # Hard deadline per payroll worker process (ms)

# ── Millware login (optional) ───────────────────────────────────────
# NOTE: browser-session.js currently falls back to a hardcoded default when
# these are unset, so a fresh clone can log in without them. That default is
# a real account credential that is visible in the source tree -- set these
# explicitly with a dedicated account rather than relying on the fallback.
MILLWARE_USERNAME=
MILLWARE_PASSWORD=
MILLWARE_BASE_URL=
