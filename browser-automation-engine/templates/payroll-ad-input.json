{
    "name": "Payroll AD Lists Input",
    "description": "Input payroll components (tunjangan/potongan) ke AD Lists Millware untuk data yang MISS",
    "steps": [
        {
            "action": "log",
            "params": {
                "message": "═══════════════════════════════════════════════════════════════"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "  PAYROLL AD LISTS AUTO INPUT"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "  Month: ${metadata.month}/${metadata.year}"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "  Total Employees: ${metadata.totalEmployees}"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "═══════════════════════════════════════════════════════════════"
            }
        },
        {
            "comment": "═══ LOGIN LIKE ATTENDANCE RUNNER ═══",
            "action": "navigate",
            "params": {
                "url": "http://millwarep3.rebinmas.com:8003/"
            }
        },
        {
            "action": "typeInput",
            "params": {
                "selector": "#txtUsername",
                "value": "adm075",
                "requiredBeforeAdd": false
            }
        },
        {
            "action": "typeInput",
            "params": {
                "selector": "#txtPassword",
                "value": "adm075",
                "requiredBeforeAdd": false
            }
        },
        {
            "action": "click",
            "params": {
                "selector": "#btnLogin"
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 1000
            }
        },
        {
            "action": "waitForElement",
            "params": {
                "selector": ".PopupBoxLogin",
                "timeout": 15000
            }
        },
        {
            "action": "click",
            "params": {
                "selector": "#MainContent_btnOkay"
            }
        },
        {
            "comment": "═══ NAVIGATE TO AD LISTS PAGE ═══",
            "action": "navigate",
            "params": {
                "url": "http://millwarep3.rebinmas.com:8003/en/PR/trx/frmPrTrxADLists.aspx"
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 2000
            }
        },
        {
            "comment": "═══ CLICK NEW BUTTON ═══",
            "action": "click",
            "params": {
                "selector": "#MainContent_btnNew"
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 1500
            }
        },
        {
            "comment": "═══ VERIFY WE'RE ON ADDET PAGE ═══",
            "action": "waitForElement",
            "params": {
                "selector": "#MainContent_ddlEmployee + input.ui-autocomplete-input",
                "timeout": 10000
            }
        },
        {
            "comment": "═══ LOOP THROUGH EMPLOYEES ═══",
            "action": "forEachProperty",
            "params": {
                "object": "employees",
                "keyName": "empKey",
                "valueName": "employee",
                "failOnError": true,
                "steps": [
                    {
                        "action": "log",
                        "params": {
                            "message": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                        }
                    },
                    {
                        "action": "log",
                        "params": {
                            "message": "  👤 Employee: ${employee.employeeName} (${employee.ptrjId})"
                        }
                    },
                    {
                        "action": "log",
                        "params": {
                            "message": "  📋 Components to input: ${employee.components.length}"
                        }
                    },
                    {
                        "action": "log",
                        "params": {
                            "message": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                        }
                    },
                    {
                        "comment": "═══ INPUT EMPLOYEE NAME ═══",
                        "action": "typeInput",
                        "params": {
                            "selector": "#MainContent_ddlEmployee + input.ui-autocomplete-input",
                            "value": "${employee.employeeName}",
                            "confirmKey": "Enter",
                            "smartSelect": true
                        }
                    },
                    {
                        "action": "wait",
                        "params": {
                            "duration": 1000
                        }
                    },
                    {
                        "comment": "═══ LOOP THROUGH COMPONENTS ═══",
                        "action": "forEach",
                        "params": {
                            "array": "employee.components",
                            "itemName": "component",
                            "failOnError": true,
                            "steps": [
                                {
                                    "action": "log",
                                    "params": {
                                        "message": "    └─ Component: ${component.componentName} → Search: ${component.adSearchKeyword} (${component.adCode}) = Rp ${component.venusAmount}"
                                    }
                                },
                                {
                                    "comment": "═══ INPUT DESCRIPTION IF FIELD EXISTS ═══",
                                    "action": "executeJavascript",
                                    "params": {
                                        "script": "const value = \"${component.componentName}\"; const selectors = ['#MainContent_txtDocDesc', '#MainContent_txtDescription', '#MainContent_txtDesc', '#MainContent_txtRemarks', 'input[id*=DocDesc]', 'input[id*=Description]', 'textarea[id*=Description]', 'textarea[id*=Remarks]']; const el = selectors.map(s => document.querySelector(s)).find(Boolean); if (el) { el.value = value; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); console.log('Payroll description set:', value); } else { console.log('Payroll description field not found; continue with ADCode/Amount'); }"
                                    }
                                },
                                {
                                    "comment": "═══ INPUT AD CODE (TaskCode) ═══",
                                    "action": "typeInput",
                                    "params": {
                                        "selector": "#MainContent_ddlTaskCode + input.ui-autocomplete-input",
                                        "value": "${component.adCode}",
                                        "confirmKey": "Enter",
                                        "smartSelect": true
                                    }
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 800
                                    }
                                },
                                {
                                    "comment": "═══ INPUT AMOUNT ═══",
                                    "action": "typeInput",
                                    "params": {
                                        "selector": "#MainContent_txtAmount",
                                        "value": "${component.venusAmount}"
                                    }
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 300
                                    }
                                },
                                {
                                    "comment": "═══ CLICK ADD BUTTON ═══",
                                    "action": "clickAndWaitForReload",
                                    "params": {
                                        "selector": "#MainContent_btnAdd",
                                        "timeout": 15000,
                                        "maxAttempts": 3,
                                        "throwOnValidation": true,
                                        "throwOnFail": true
                                    }
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 1000
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "comment": "═══ CLICK SAVE BUTTON ═══",
                        "action": "click",
                        "params": {
                            "selector": "#MainContent_btnSave"
                        }
                    },
                    {
                        "action": "wait",
                        "params": {
                            "duration": 2000
                        }
                    },
                    {
                        "action": "log",
                        "params": {
                            "message": "  ✅ Saved: ${employee.employeeName}"
                        }
                    },
                    {
                        "comment": "═══ PREPARE NEXT EMPLOYEE FORM ═══",
                        "action": "if",
                        "params": {
                            "condition": "!isLast",
                            "thenSteps": [
                                {
                                    "action": "navigate",
                                    "params": {
                                        "url": "http://millwarep3.rebinmas.com:8003/en/PR/trx/frmPrTrxADLists.aspx"
                                    }
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 1500
                                    }
                                },
                                {
                                    "action": "click",
                                    "params": {
                                        "selector": "#MainContent_btnNew"
                                    }
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 1500
                                    }
                                },
                                {
                                    "action": "waitForElement",
                                    "params": {
                                        "selector": "#MainContent_ddlEmployee + input.ui-autocomplete-input",
                                        "timeout": 10000
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        },
        {
            "action": "log",
            "params": {
                "message": "═══════════════════════════════════════════════════════════════"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "  ✅ PAYROLL AD LISTS INPUT COMPLETED"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "═══════════════════════════════════════════════════════════════"
            }
        }
    ]
}
