{
    "name": "Input Flow - Simple",
    "description": "Template sederhana untuk input absensi dengan filter reguler/overtime miss",
    "dataFile": "testing_data/test_simple.json",
    "steps": [
        {
            "comment": "═══ LOGIN & NAVIGATE ═══",
            "action": "include",
            "params": {
                "template": "template-flow"
            }
        },
        {
            "comment": "═══ LOOP EMPLOYEES ═══",
            "action": "forEach",
            "params": {
                "items": "data.data",
                "itemName": "employee",
                "steps": [
                    {
                        "action": "log",
                        "params": {
                            "message": "👤 Processing: ${employee.EmployeeName} (${employee.PTRJEmployeeID})"
                        }
                    },
                    {
                        "comment": "═══ LOOP ATTENDANCE DATES ═══",
                        "action": "include",
                        "params": {
                            "template": "_attendance_logic_v5"
                        }
                    },
                    {
                        "comment": "═══ VERIFY SYNC ═══",
                        "action": "verifyEmployeeSync",
                        "params": {}
                    },
                    {
                        "action": "if",
                        "params": {
                            "condition": "context.employeeFailed === true",
                            "thenSteps": [
                                {
                                    "action": "log",
                                    "params": {
                                        "message": "❌ ${employee.EmployeeName}: Some transfers failed"
                                    }
                                }
                            ],
                            "elseSteps": [
                                {
                                    "action": "log",
                                    "params": {
                                        "message": "✅ ${employee.EmployeeName}: All transfers SUCCESSFUL!"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        },
        {
            "action": "log",
            "params": {
                "message": "✅ Selesai memproses semua data absensi"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "📊 Failed employees CSV updated in REAL-TIME during automation"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "📍 Location: browser-automation-engine/logs/emp_failed/"
            }
        },
        {
            "action": "log",
            "params": {
                "message": "💡 File: failed_employees_*.csv (can be opened in Excel while automation runs)"
            }
        }
    ]
}
