{
    "name": "Leave Input - Full (Annual & Sick)",
    "description": "Complete leave input flow for both Annual Leave and Sick Leave. Use params.leaveType='annual' or 'sick'",
    "params": {
        "leaveType": "annual"
    },
    "steps": [
        {
            "action": "setVariable",
            "params": {
                "variable": "__domValuePairs",
                "value": []
            }
        },
        {
            "action": "log",
            "params": {
                "message": "    -> Input ${leaveType.toUpperCase()} LEAVE: ${attendance.status} (${attendance.leaveDescription})"
            }
        },
        {
            "action": "waitForElement",
            "params": {
                "selector": ".ui-autocomplete-input.CBOBox",
                "timeout": 10000
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 1000
            }
        },
        {
            "action": "formatDate",
            "params": {
                "date": "${attendance.date}",
                "saveTo": "formattedDateLeave"
            }
        },
        {
            "comment": "═══ INPUT DOC DATE (PERTAMA - LEAVE) ═══",
            "action": "typeInput",
            "params": {
                "selector": "#MainContent_txtDocDate",
                "value": "${formattedDateLeave}",
                "label": "Document Date",
                "skipIfSame": true
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 500
            }
        },
        {
            "comment": "═══ INPUT TRANSACTION DATE (KEDUA - LEAVE) ═══",
            "action": "typeInput",
            "params": {
                "selector": "#MainContent_txtTrxDate",
                "value": "${formattedDateLeave}",
                "label": "Transaction Date",
                "skipIfSame": true
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 500
            }
        },
        {
            "action": "pressKey",
            "params": {
                "key": "ArrowDown"
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 200
            }
        },
        {
            "action": "pressKeyAndWaitForReload",
            "params": {
                "key": "Enter",
                "timeout": 30000
            }
        },
        {
            "comment": "═══ WAIT FOR PAGE TO STABILIZE AFTER REFRESH ═══",
            "action": "waitForElement",
            "params": {
                "selector": ".ui-autocomplete-input.CBOBox",
                "timeout": 20000
            }
        },
        {
            "action": "retryInputWithValidation",
            "params": {
                "selector": ".ui-autocomplete-input.CBOBox",
                "index": 0,
                "value": "${employee.PTRJEmployeeID}",
                "validationSelector": "#MainContent_ddlEmployee_RFV",
                "maxRetries": 1,
                "formReentryFields": [],
                "forceInput": true,
                "checkIfAlreadyFilled": false
            }
        },
        {
            "action": "wait",
            "params": {
                "duration": 2000
            }
        },
        {
            "action": "checkEmployeeInputSuccess",
            "params": {
                "validationErrorSelector": "#MainContent_ddlEmployee_RFV",
                "timeout": 15000
            }
        },
        {
            "action": "if",
            "params": {
                "condition": "metadata.employeeInputFailed !== true",
                "thenSteps": [
                    {
                        "action": "waitForElement",
                        "params": {
                            "selector": "#MainContent_ddlShift",
                            "timeout": 10000
                        }
                    },
                    {
                        "action": "wait",
                        "params": {
                            "duration": 500
                        }
                    },
                    {
                        "comment": "═══ ANNUAL LEAVE: Use (GA9130) PERSONNEL ANNUAL LEAVE ═══",
                        "action": "if",
                        "params": {
                            "condition": "leaveType === 'annual'",
                            "thenSteps": [
                                {
                                    "action": "retryInputWithValidation",
                                    "params": {
                                        "selector": ".ui-autocomplete-input.CBOBox",
                                        "index": 1,
                                        "value": "(GA9130) PERSONNEL ANNUAL LEAVE",
                                        "validationSelector": "#MainContent_ddlTaskCode_RFV",
                                        "maxRetries": 1,
                                        "forceInput": true,
                                        "checkIfAlreadyFilled": false
                                    }
                                }
                            ],
                            "elseSteps": [
                                {
                                    "comment": "═══ SICK LEAVE: Use (GA9127) (AL) PERSONNEL SICK LEAVE ═══",
                                    "action": "retryInputWithValidation",
                                    "params": {
                                        "selector": ".ui-autocomplete-input.CBOBox",
                                        "index": 1,
                                        "value": "(GA9127) (AL) PERSONNEL SICK LEAVE",
                                        "validationSelector": "#MainContent_ddlTaskCode_RFV",
                                        "maxRetries": 1,
                                        "forceInput": true,
                                        "checkIfAlreadyFilled": false
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "action": "wait",
                        "params": {
                            "duration": 1000
                        }
                    },
                    {
                        "action": "typeInput",
                        "params": {
                            "selector": "#MainContent_txtHours",
                            "value": "${attendance.calculatedLeaveHours}",
                            "label": "Hours",
                            "restoreBeforeAdd": true,
                            "noPostback": true
                        }
                    },
                    {
                        "comment": "IMPORTANT: Skip Enter key - it causes implicit ASP.NET postback which leads to double submission",
                        "action": "log",
                        "params": {
                            "message": "  Skipping Enter key - will click Add button directly to prevent double submission"
                        }
                    },
                    {
                        "comment": "═══ VALIDATION: Check if Regular radio is still selected before submitting ═══",
                        "action": "checkElementState",
                        "params": {
                            "selector": "#MainContent_rblOT_0",
                            "saveTo": "valRegState"
                        }
                    },
                    {
                        "action": "if",
                        "params": {
                            "condition": "valRegState.checked === true",
                            "thenSteps": [
                                {
                                    "action": "clickAndWaitForReload",
                                    "params": {
                                        "selector": "#MainContent_btnAdd",
                                        "timeout": 15000,
                                        "skipPreAddQuiet": true
                                    }
                                }
                            ],
                            "elseSteps": [
                                {
                                    "action": "log",
                                    "params": {
                                        "message": "CRITICAL ERROR: Regular radio not checked after input! Aborting entry."
                                    }
                                },
                                {
                                    "action": "reloadPage",
                                    "params": {}
                                },
                                {
                                    "action": "wait",
                                    "params": {
                                        "duration": 5000
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "action": "waitForReady",
                        "params": {
                            "selector": ".ui-autocomplete-input.CBOBox",
                            "timeout": 10000
                        }
                    },
                    {
                        "action": "validateText",
                        "params": {
                            "selector": "#MainContent_lblTotalNormalHour",
                            "minLength": 1,
                            "throwOnFail": false
                        }
                    }
                ],
                "elseSteps": [
                    {
                        "action": "log",
                        "params": {
                            "message": "    SKIP: Employee input failed"
                        }
                    }
                ]
            }
        }
    ]
}
