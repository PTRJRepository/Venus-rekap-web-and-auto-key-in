{
  "id": "web-scraper",
  "name": "Web Scraper",
  "description": "Generic web scraping template - customize as needed",
  "version": "1.0.0",
  "variables": {
    "timeout": 30000
  },
  "nodes": [
    {
      "id": "start",
      "type": "navigate",
      "name": "Open Website",
      "parameters": {
        "url": "${input.url}",
        "waitUntil": "load"
      }
    },
    {
      "id": "wait-content",
      "type": "waitForElement",
      "name": "Wait for Content",
      "parameters": {
        "selector": "${input.selector}",
        "timeout": "${timeout}"
      }
    },
    {
      "id": "extract",
      "type": "extractAll",
      "name": "Extract Data",
      "parameters": {
        "selector": "${input.selector}",
        "output": "scrapedData"
      }
    },
    {
      "id": "screenshot",
      "type": "screenshot",
      "name": "Take Screenshot",
      "parameters": {
        "filename": "result.png",
        "type": "png"
      }
    },
    {
      "id": "log",
      "type": "log",
      "name": "Show Result",
      "parameters": {
        "message": "Extracted ${scrapedData.length} items"
      }
    }
  ]
}
